# Public site
NEXT_PUBLIC_APP_URL=https://seaworthy.dev
NEXT_PUBLIC_CONTACT_EMAIL=hello@seaworthy.dev
NEXT_PUBLIC_SECURITY_EMAIL=security@seaworthy.dev
NEXT_PUBLIC_COMPANY_NAME=Seaworthy
# Optional: used in the Terms governing-law section.
NEXT_PUBLIC_JURISDICTION=

# Production persistence (Postgres: Neon, Supabase, RDS, etc.)
# Include sslmode=require for hosted providers, e.g.
# postgresql://user:pass@host/db?sslmode=require
# If unset, scans/waitlist fall back to local .data/ (development only).
DATABASE_URL=
DATABASE_POOL_MAX=5

# Distributed rate limiting (Upstash Redis REST). Optional.
# Without it, rate limits are per-instance in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error webhook (Slack/Discord/generic JSON endpoint). Optional.
ERROR_WEBHOOK_URL=

# Deep scan (paid-tier gate, V2 billing will replace this)
# Set DEEP_SCAN_ENABLED=true and a strong random DEEP_SCAN_KEY to allow mode:"deep"
# requests that send header: x-seaworthy-deep-key
DEEP_SCAN_ENABLED=false
DEEP_SCAN_KEY=
